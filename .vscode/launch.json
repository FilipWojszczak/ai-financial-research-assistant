{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "financial_assistant.api.server:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "justMyCode": true
    },
    {
      "name": "Debug Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-v"],
      "env": {
        "ENVIRONMENT": "testing",
        "RUN_RABBITMQ_TESTS": "1",
        "RUN_INGESTION_TESTS": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
