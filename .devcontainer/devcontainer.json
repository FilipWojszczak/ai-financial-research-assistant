{
  "name": "AI Financial Research Assistant Dev Environment",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "app",
  // Mount the repo at the same absolute path as on the host. Claude Code keys chat
  // history by the working directory, so this shares chats between host and container.
  "workspaceFolder": "${localWorkspaceFolder}",
  // Non-root user; VS Code remaps its UID/GID to the host user's on Linux, so files
  // written to bind mounts (~/.claude, the repo) stay owned by the host user.
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "false",
      "username": "vscode",
      "configureZshAsDefaultShell": "false"
    },
    "ghcr.io/devcontainers/features/node:2.0.0": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
    "source=ai-financial-bash-history,target=/commandhistory,type=volume",
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached"
  ],
  "remoteEnv": {
    // The Claude Code native installer puts the binary in ~/.local/bin.
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",

        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit",
          "source.organizeImports": "explicit"
        },

        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml"
        },
        "[toml]": {
          "editor.defaultFormatter": "tamasfe.even-better-toml"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "sqltools.connections": [
          {
            "name": "AI Financial DB",
            "driver": "PostgreSQL",
            "server": "${containerEnv:POSTGRES_HOST}",
            "port": 5432,
            "database": "${containerEnv:POSTGRES_DB}",
            "username": "${containerEnv:POSTGRES_USER}",
            "password": "${containerEnv:POSTGRES_PASSWORD}"
          }
        ]
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions",
        "mikestead.dotenv",
        "davidanson.vscode-markdownlint",
        "esbenp.prettier-vscode",
        "anthropic.claude-code",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ]
    }
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /commandhistory && touch /commandhistory/.bash_history && echo 'export HISTFILE=/commandhistory/.bash_history' >> ~/.bashrc && echo 'export PROMPT_COMMAND=\"history -a; history -c; history -r; $PROMPT_COMMAND\"' >> ~/.bashrc && uv sync && uv run pre-commit install && uv run pre-commit install --hook-type commit-msg && curl -fsSL https://claude.ai/install.sh | bash"
}
