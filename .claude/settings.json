{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(RUN_RABBITMQ_TESTS=1 uv run pytest *)",
      "Bash(RUN_INGESTION_TESTS=1 uv run pytest *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.*.example)",
      "Edit(uv.lock)",
      "Edit(.git/**)"
    ],
    "ask": [
      "Bash(uv run alembic downgrade *)"
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  }
}
